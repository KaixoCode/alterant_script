
// ------------------------------------------------

@name "Limit"
@author "Kaixo"
@description "The Limit Alterant applies a limiter to each individual spectral bin."
@inplace true

@graph eq base = 0.5

@param 0 name = "Mix"      default = 1.0  center = 0.0  transform = range[   0, 100]   format = percent 
@param 1 name = "Gain"     default = 0.5  center = 0.0  transform = range[   0, 200]   format = percent 
@param 2 name = "Offset"   default = 1.0  center = 1.0  transform = range[-100,   0]   format = percent 
@param 3 name = "Attack"   default = 0.0  center = 0.0  transform = power[0, 1000, 3]  format = time 
@param 4 name = "Release"  default = 0.0  center = 0.0  transform = power[0, 1000, 3]  format = time 

@data stereo_buffer envelope

// ------------------------------------------------

param0 = min(max(param[0], 0), 1)
param1 = max(param[1], 0.0)
param2 = min(param[2], 1.0)
param3 = max(param[3], 0.0)
param4 = max(param[4], 0.0)

mix = param0
gain = param1 * 2.0
offset = param2 - 1
attack  = exp(-1 / (0.000000001 + pow(param3, 3) * sample_rate))
release = exp(-1 / (0.000000001 + pow(param4, 3) * sample_rate))

// ------------------------------------------------

max = offset + graph
value = gain * input
abs_value = abs(value)

excess = max(abs_value - max, 0)
coefficient = envelope < excess ? attack : release
envelope = excess + (envelope - excess) * coefficient

limited = max(abs_value - envelope, 0)
output = value + mix * ((value < 0 ? -limited : limited) - value)

// ------------------------------------------------
