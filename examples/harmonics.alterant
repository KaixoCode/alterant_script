
// ------------------------------------------------

@name "Harmonics"
@author "Kaixo"
@description "Use 1x Frq Lnk and disable root partial lock to map partials to a chord. Use the first 12 bins of the graph to define a scale to snap to."
@inplace false

@graph bar base = 0.5

@param 0 name="Mix"       default=1.0   transform=range[0,100]  format=percent
@param 1 name="Third"     default=0.667 transform=range[-2,1]   format=default
@param 2 name="Fifth"     default=0.5   transform=range[-1,1]   format=default
@param 3 name="Seventh"   default=0.5   transform=range[-1,1]   format=default
@param 4 name="Notes"     default=0.667 transform=range[1,4]    format=integer

// ------------------------------------------------

snapToNote = stereo(i, i)
snapToNote[(graph[i + 1] == 0 ? i + 1 : i) : zero] = snapToNote

mix = param[0]
third_note_offset = param[1] * 3 + 2
fifth_note_offset = param[2] * 2 + 6
seven_note_offset = param[3] * 2 + 10
notes = round(param[4] * 3 + 1);

// ------------------------------------------------

note = 69 + 12 * log(frequency / 440) / ln2
root_note_snapped = floor(note / 12) * 12 + snapToNote[note % 12 : linear]

third_target = root_note_snapped + third_note_offset
fifth_target = root_note_snapped + fifth_note_offset
seven_target = root_note_snapped + seven_note_offset

third_note_snapped = floor(third_target / 12) * 12 + snapToNote[third_target % 12 : linear]
fifth_note_snapped = floor(fifth_target / 12) * 12 + snapToNote[fifth_target % 12 : linear]
seven_note_snapped = floor(seven_target / 12) * 12 + snapToNote[seven_target % 12 : linear]

root = pow(2, (root_note_snapped - note) / 12)
third = pow(2, (third_note_snapped - root_note_snapped) / 12)
fifth = pow(2, (fifth_note_snapped - root_note_snapped) / 12)
seven = pow(2, (seven_note_snapped - root_note_snapped) / 12)

harmonic = floor(i / notes) + 1
position = i % notes

chord_ratio =
  position == 0 ? harmonic * root :
  position == 1 ? harmonic * root * third :
  position == 2 ? harmonic * root * fifth :
                  harmonic * root * seven

output = lerp(mix, input, chord_ratio / 2 / (i + 1) - 0.5)

// ------------------------------------------------
