    
// ------------------------------------------------

@name "Pitch Map"
@author "Kaixo"
@description "Independently snaps each partial to a graph-defined pitch scale. Use the first 12 bins of the bar graph to define the scale. Set Frq Lnk to 1.00 + for this to work."
@inplace true
    
// ------------------------------------------------

@param 0 name="Mix" default=1 transform=range[0,100] format=percent
@param 1 name="Cutoff" default=1 transform=range[0,100] format=percent

// ------------------------------------------------

// Calculate the snapped note for each note number, basically just remaps note numbers
snapToNote = stereo(i, i)
snapToNote[(graph[i + 1] == 0 ? i + 1 : i) : zero] = snapToNote

// Calculate the exact frequency of each partial based on the incoming frequency data.
// Turn the frequency into a midi note number, snap that to the scale, and turn it back
// into a frequency.
partial = max(frequency * (i + 1 + input), 0.000001)
midi = 69 + 12 * log(partial / 440) * log2e
note = round(midi)
class = snapToNote[note % 12 : none]
delta = ((class - note % 12 + 6) % 12) - 6
snapped = note + delta

mix = (i > param[1] * size ? 0 : 1) * param[0]
result = lerp(mix, midi, snapped)
newFreq = 440 * exp((result - 69) * ln2 / 12)

output = newFreq / frequency - (i + 1)
    
// ------------------------------------------------
